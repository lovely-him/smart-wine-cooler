# ── 服务本身 ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── 数据放哪（引导信息，不进数据库）──
# 图片与数据库都在这下面；数据库路径不在数据库里，库坏了程序仍能起来
DATA_DIR=data

# ── 采集 ──
# 板子：真实摄像头
CAMERA_BACKEND=v4l2
# 宿主机：没有摄像头，用图片目录模拟。目录里放一张固定图，静止判定天然成立；
# 放两张不同的图则永远判不出静止，用来验证「这次没拍成」
# CAMERA_BACKEND=image_dir
# CAMERA_IMAGE_DIR=data/samples/layer1
