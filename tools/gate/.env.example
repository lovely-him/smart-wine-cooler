# 门禁脚本的本机配置：复制成 .env 后按实际填写（.env 不进版本库）
# 板卡
BOARD_HOST=192.168.64.18
BOARD_USER=kickpi
BOARD_ROOT=/home/kickpi/aicam
BOARD_PYTHON=python3

# 模型：宿主用 onnx，板卡用 rknn（绝对路径或相对 $BOARD_ROOT）
HOST_MODEL=../embed_lab/models/yolov8x/yolov8x.onnx
BOARD_MODEL=/home/kickpi/aicam/vendor/models/yolov8x_rk3588_fp16.rknn

# 特征模型（embed-onnx-vs-rknn 子命令用）
EMBED_HOST_MODEL=../embed_lab/models/mobilenetv2_pool.onnx
EMBED_BOARD_MODEL=/home/kickpi/aicam/vendor/models/mobilenetv2_pool_rk3588_fp16.rknn
