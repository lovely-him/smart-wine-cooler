# 部署目标（本机配置，不进版本库）
# 复制为 deploy/.env 后按实际填写，留空的项会直接报错

BOARD_HOST=
BOARD_USER=
BOARD_DIR=

# 板子上用什么 python（系统 python 即可，不建 venv）
BOARD_PYTHON=python3

# 服务监听的端口，status 用它检查是否真的起来了
SERVICE_PORT=8080

# 板子上启动服务的命令；切换新旧代码时只改这一行
SERVICE_CMD="$BOARD_PYTHON -m server.main"

# 要同步到板子的路径（相对仓库根，空格分隔）
# 切换新旧代码时一并调整
SYNC_PATHS="server requirements.txt requirements-board.txt"
